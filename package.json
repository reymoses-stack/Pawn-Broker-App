{
  "name": "gold-nexus-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Gold Pawn Brokerage & Lending Ecosystem",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:broker": "npm run dev --workspace=apps/gold-pawn-broker",
    "dev:customer": "npm run dev --workspace=apps/nexus-gold-customer",
    "dev:business": "npm run dev --workspace=apps/gold-business-os",
    "build:broker": "npm run build --workspace=apps/gold-pawn-broker",
    "build:customer": "npm run build --workspace=apps/nexus-gold-customer",
    "build:business": "npm run build --workspace=apps/gold-business-os",
    "build:all": "npm run build --workspaces",
    "start:backend": "cd backend && go run main.go"
  },
  "keywords": [
    "pawn-broker",
    "gold-loan",
    "supabase",
    "golang",
    "react",
    "typescript",
    "vercel"
  ],
  "author": "Revanth Moses",
  "license": "MIT"
}
