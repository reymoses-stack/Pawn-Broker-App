# ============================================================================
# NEXUS GOLD BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
PORT=8080

# Supabase PostgreSQL Connection String (Found in Supabase: Project Settings -> Database -> URI)
# Example: postgres://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Project API Credentials (Found in Supabase: Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed Frontend Origins (supports local dev and any Vercel deployments)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://*.vercel.app,*
